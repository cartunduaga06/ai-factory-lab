# AI Factory Lab — example configuration.
#
# Copy this file to `.env` and fill in real values locally.
# NEVER commit a populated `.env`. This example file must contain placeholders only.
# Placeholders use the form `<...>` and are intentionally not valid credentials.

# ---------------------------------------------------------------------------
# Factory (control plane itself)
# ---------------------------------------------------------------------------
FACTORY_ENV=development
FACTORY_LOG_LEVEL=INFO
FACTORY_LOG_FORMAT=text

# ---------------------------------------------------------------------------
# GitHub — source of work (Issues) and target of results (Pull Requests)
# ---------------------------------------------------------------------------
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=<your-github-token>

# Separate WRITE credential used only to push an isolated run branch and open a
# Pull Request (Phase 5). It must NOT be the read-only intake token above: the
# factory never implicitly reuses a read-scoped credential for a write. Omit it
# and publication simply refuses to run rather than falling back.
GITHUB_WRITE_TOKEN=<your-github-write-token>
# Non-secret HTTPS publication username. Defaults to x-access-token when unset.
GITHUB_WRITE_USERNAME=x-access-token

# Repository that hosts factory tasks as GitHub Issues (control plane).
FACTORY_GITHUB_REPO=cartunduaga06/ai-factory-lab

# Default product repository agents operate on (execution target).
# The factory never pushes to main of any product repository.
FACTORY_TARGET_REPO=cartunduaga06/finanza-ia
# Optional multi-project registry. When set, this operator-owned JSON replaces
# the single target/checkout/gates route for CODE tasks. Trello cards declare
# only `project_id: <id>`; they cannot choose a repository. Each source checkout
# must have an HTTPS origin matching its registered repository. Keep Dulces out
# until its real repository and checkout exist.
# FACTORY_PROJECTS=[{"project_id":"ai-factory-lab","repository":"cartunduaga06/ai-factory-lab","source_checkout":"/path/to/ai-factory-lab","base_ref":"main","context_profile":"repository","deploy_policy":"human-only","required_ci_checks":["pytest / Ruff / Mypy (Python 3.11)","pytest / Ruff / Mypy (Python 3.12)"],"gates":[{"name":"pytest","argv":["pytest"],"required":true}]}]

# Base branch a published Pull Request targets. Defaults to `main`. The factory
# never pushes to this branch; it only opens a PR against it.
FACTORY_TARGET_DEFAULT_BRANCH=main

# Git host an authenticated HTTPS push may target. Defaults to `github.com`. The
# factory validates the *effective* push destination (git's own resolution,
# including pushurl and url.*.insteadOf/pushInsteadOf rewrites) and refuses any
# network destination whose host is not this one, or whose owner/repository is
# not the task's target repository. Set this for a GitHub Enterprise host.
# A hostname is not a secret and may appear in `--show-config`.
FACTORY_GITHUB_GIT_HOST=github.com

# ---------------------------------------------------------------------------
# Agent engine. Codex is the temporary default; choose openhands explicitly to
# retain the local Agent Server path. A run stays with its selected engine.
FACTORY_AGENT_ENGINE=codex

# OpenHands — local Agent Server execution engine (HTTP API)
# ---------------------------------------------------------------------------
# Base URL of the OpenHands Agent Server, e.g. http://localhost:60000.
OPENHANDS_BASE_URL=<your-openhands-base-url>

# Request-authentication key for the agent server, sent as `X-Session-API-Key`.
# Omit when the server is unauthenticated (a local server usually is).
# This is NOT an LLM key: the factory never supplies LLM credentials.
OPENHANDS_SESSION_API_KEY=<your-openhands-session-api-key>

# Server-side agent profile the adapter dispatches with. Preferred, because the
# agent server resolves the LLM and its credential itself, so the factory never
# handles an LLM key. When unset, the adapter falls back to OPENHANDS_API_KEY.
OPENHANDS_AGENT_PROFILE_ID=<your-agent-profile-id>

# Optional: an OpenHands execution credential. Only needed for a server whose
# agent profile has no LLM key of its own. Never logged or committed.
OPENHANDS_API_KEY=<your-openhands-api-key>

# Command the OpenHands conversation runs as a shared-workspace hook. When set,
# it is passed as the conversation's `hook_config`: it normalizes file modes
# owner-side after each `file_editor` write (a new file is created 0600 by the
# editor's atomic write, regardless of umask) and blocks completion (exit 2)
# when the shared permission policy cannot be enforced. It must be runnable
# inside the OpenHands container (as UID 10001), and the run's Git metadata must
# be mounted read-only. A command is configuration, not a secret.
# See docs/openhands-shared-workspace-runtime.md.
OPENHANDS_SHARED_WORKSPACE_HOOK_COMMAND=python -m factory.integrations.workspace.shared_policy

# ---------------------------------------------------------------------------
# Codex — noninteractive CLI, using the server's existing ChatGPT login.
# The factory forwards HOME/CODEX_HOME to the CLI and does not need an API key.
# ---------------------------------------------------------------------------
# Ensure `codex` is installed and authenticated for the factory service user.
# Factory workers ignore ~/.codex/config.toml and use this explicit model/effort.
# Authentication still comes from the service user's existing Codex login.
FACTORY_CODEX_MODEL=gpt-6-luna
FACTORY_CODEX_REASONING_EFFORT=low
# Optional pinned ECC verification guidance for code tasks; unset by default.
# Factory quality gates remain authoritative. No ECC plugin or hooks are installed.
# FACTORY_CODEX_ECC_SKILL=verification-loop
# FACTORY_CODEX_ECC_SKILL=auto  # requires one [type:verification] title tag

# ---------------------------------------------------------------------------
# Database — persistence for tasks, runs and state transitions
# ---------------------------------------------------------------------------
# Phase 2A supports SQLite only. PostgreSQL (async) remains a future target.
# The plain `sqlite:///` form and the SQLAlchemy `sqlite+pysqlite:///` form are
# both accepted; any other scheme is rejected with a clear error.
DATABASE_URL=sqlite:///./factory.db

# ---------------------------------------------------------------------------
# Workspaces — isolated checkouts where agents run
# ---------------------------------------------------------------------------
FACTORY_WORKSPACE_ROOT=./.workspaces
# Optional operational scratch capability. Must be an existing absolute directory,
# owned by the non-root Factory service UID with mode 0700. Unset means fail closed.
# FACTORY_OPERATIONAL_SCRATCH_ROOT=/srv/ai-factory/operational-scratch
# An operational-only worker may omit FACTORY_SOURCE_CHECKOUT,
# FACTORY_TARGET_REPO and GITHUB_WRITE_TOKEN. CODE tasks then fail closed.

# Path visible to the OpenHands Agent Server container for the same workspace.
# On ai-server use FACTORY_WORKSPACE_ROOT=/srv/ai-factory/workspaces and
# OPENHANDS_WORKSPACE_ROOT=/projects.
OPENHANDS_WORKSPACE_ROOT=./.workspaces

# One task per invocation; timeout leaves the durable run resumable.
FACTORY_RUN_POLL_INTERVAL=5
FACTORY_RUN_TIMEOUT=1800

# Seconds to wait between iterations of `python -m factory watch` when no
# eligible task was found. Only the watch loop reads it; `factory run` stays a
# single bounded pass. Keep it positive so an unattended worker cannot spin
# against the GitHub API.
FACTORY_WATCH_IDLE_INTERVAL=60
# Maximum simultaneous task workers for `python -m factory pool` (1 or 2).
FACTORY_MAX_CONCURRENCY=2

# Control Tower heartbeat is persisted after a successful agent collection at
# most every 180 seconds. RUNNING is displayed as STALLED after two missed
# intervals; STALLED is an observed state, not a lifecycle transition.
FACTORY_HEARTBEAT_INTERVAL=180
FACTORY_MISSED_HEARTBEATS=2

# Optional Trello projection: the existing "Estado actual — AI Factory Lab"
# card ID and a dedicated credential with card edit permission. Leave unset to
# keep status local. These credentials must remain outside version control.
FACTORY_TRELLO_STATUS_CARD_ID=<trello-card-id>
FACTORY_TRELLO_KEY=<trello-api-key>
FACTORY_TRELLO_TOKEN=<trello-api-token>

# Optional backlog bridge. Set both IDs to enable Sprint/READY reconciliation
# before each watch/run intake pass. `sync-backlog --card-id <id>` handles a
# webhook-selected card; a webhook receiver must authenticate Trello separately.
# A checklist named Dependencies must have every item checked.
FACTORY_TRELLO_BACKLOG_LIST_ID=<sprint-list-id>
FACTORY_TRELLO_READY_LABEL_ID=<ready-label-id>
FACTORY_TRELLO_DONE_LIST_ID=<done-list-id>

# Local checkout of the target repository the workspace provisioner branches
# from with `git worktree`. Injected, never hard-coded. The source checkout is
# left on its existing branch and is never pushed to or checked out by the
# factory. Required before any dispatch can prepare a physical workspace.
FACTORY_SOURCE_CHECKOUT=<your-local-checkout-of-the-target-repo>

# Optional commit-ish a new factory branch starts from. Defaults to the source
# checkout's current HEAD.
FACTORY_WORKSPACE_BASE_REF=<branch-tag-or-sha>

# ---------------------------------------------------------------------------
# Quality gates — declarative validation commands run in the run's workspace
# ---------------------------------------------------------------------------
# JSON array of gate objects: {name, argv, required?}. `argv` is a list, never a
# shell string; commands run with shell=False, a bounded timeout, and a minimal
# environment. Set to `[]` (or leave unset) for no gates: the factory never
# invents a gate a repository did not define, and no gate means nothing blocks.
FACTORY_QUALITY_GATES=[{"name":"pytest","argv":["pytest"],"required":true},{"name":"ruff_check","argv":["ruff","check","."],"required":true},{"name":"ruff_format","argv":["ruff","format","--check","."],"required":true},{"name":"mypy","argv":["mypy"],"required":true}]
# Optional task-specific additions keyed by the source issue reference. These
# commands are operator-owned configuration, never parsed from an agent edit.
FACTORY_TASK_QUALITY_GATES={}
