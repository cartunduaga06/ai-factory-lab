# AI Factory Lab — example configuration.
#
# Copy this file to `.env` and fill in real values locally.
# NEVER commit a populated `.env`. This example file must contain placeholders only.
# Placeholders use the form `<...>` and are intentionally not valid credentials.

# ---------------------------------------------------------------------------
# Factory (control plane itself)
# ---------------------------------------------------------------------------
FACTORY_ENV=development
FACTORY_LOG_LEVEL=INFO
FACTORY_LOG_FORMAT=text

# ---------------------------------------------------------------------------
# GitHub — source of work (Issues) and target of results (Pull Requests)
# ---------------------------------------------------------------------------
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=<your-github-token>

# Separate WRITE credential used only to push an isolated run branch and open a
# Pull Request (Phase 5). It must NOT be the read-only intake token above: the
# factory never implicitly reuses a read-scoped credential for a write. Omit it
# and publication simply refuses to run rather than falling back.
GITHUB_WRITE_TOKEN=<your-github-write-token>

# Repository that hosts factory tasks as GitHub Issues (control plane).
FACTORY_GITHUB_REPO=cartunduaga06/ai-factory-lab

# Default product repository agents operate on (execution target).
# The factory never pushes to main of any product repository.
FACTORY_TARGET_REPO=cartunduaga06/finanza-ia

# Base branch a published Pull Request targets. Defaults to `main`. The factory
# never pushes to this branch; it only opens a PR against it.
FACTORY_TARGET_DEFAULT_BRANCH=main

# ---------------------------------------------------------------------------
# OpenHands — one supported agent execution engine (Agent Server, HTTP API)
# ---------------------------------------------------------------------------
# Base URL of the OpenHands Agent Server, e.g. http://localhost:60000.
OPENHANDS_BASE_URL=<your-openhands-base-url>

# Request-authentication key for the agent server, sent as `X-Session-API-Key`.
# Omit when the server is unauthenticated (a local server usually is).
# This is NOT an LLM key: the factory never supplies LLM credentials.
OPENHANDS_SESSION_API_KEY=<your-openhands-session-api-key>

# Server-side agent profile the adapter dispatches with. Preferred, because the
# agent server resolves the LLM and its credential itself, so the factory never
# handles an LLM key. When unset, the adapter falls back to OPENHANDS_API_KEY.
OPENHANDS_AGENT_PROFILE_ID=<your-agent-profile-id>

# Optional: an OpenHands execution credential. Only needed for a server whose
# agent profile has no LLM key of its own. Never logged or committed.
OPENHANDS_API_KEY=<your-openhands-api-key>

# ---------------------------------------------------------------------------
# Codex — another supported agent execution engine (optional)
# ---------------------------------------------------------------------------
CODEX_API_KEY=<your-codex-api-key>

# ---------------------------------------------------------------------------
# Database — persistence for tasks, runs and state transitions
# ---------------------------------------------------------------------------
# Phase 2A supports SQLite only. PostgreSQL (async) remains a future target.
# The plain `sqlite:///` form and the SQLAlchemy `sqlite+pysqlite:///` form are
# both accepted; any other scheme is rejected with a clear error.
DATABASE_URL=sqlite:///./factory.db

# ---------------------------------------------------------------------------
# Workspaces — isolated checkouts where agents run
# ---------------------------------------------------------------------------
FACTORY_WORKSPACE_ROOT=./.workspaces

# Local checkout of the target repository the workspace provisioner branches
# from with `git worktree`. Injected, never hard-coded. The source checkout is
# left on its existing branch and is never pushed to or checked out by the
# factory. Required before any dispatch can prepare a physical workspace.
FACTORY_SOURCE_CHECKOUT=<your-local-checkout-of-the-target-repo>

# Optional commit-ish a new factory branch starts from. Defaults to the source
# checkout's current HEAD.
FACTORY_WORKSPACE_BASE_REF=<branch-tag-or-sha>

# ---------------------------------------------------------------------------
# Quality gates — declarative validation commands run in the run's workspace
# ---------------------------------------------------------------------------
# JSON array of gate objects: {name, argv, required?}. `argv` is a list, never a
# shell string; commands run with shell=False, a bounded timeout, and a minimal
# environment. Set to `[]` (or leave unset) for no gates: the factory never
# invents a gate a repository did not define, and no gate means nothing blocks.
FACTORY_QUALITY_GATES=[{"name":"tests","argv":["pytest"],"required":true},{"name":"lint","argv":["ruff","check","."],"required":true}]
