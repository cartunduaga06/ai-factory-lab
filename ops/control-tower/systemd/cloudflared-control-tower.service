[Unit]
Description=Cloudflare Tunnel for AI Factory Lab Control Tower
Wants=network-online.target
After=network-online.target factory-control-tower.service

[Service]
Type=simple
User=carlos
Group=carlos
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel --config /etc/cloudflared/control-tower.yml run
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
