[Unit]
Description=AI Factory Lab read-only Control Tower
After=network.target

[Service]
Type=simple
User=carlos
Group=carlos
WorkingDirectory=/srv/ai-factory/control-plane
EnvironmentFile=/srv/ai-factory/config/runtime.env
ExecStart=/srv/ai-factory/control-plane/.venv/bin/python -m factory status --serve --host 127.0.0.1 --port 8765
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/ai-factory/control-plane

[Install]
WantedBy=multi-user.target
